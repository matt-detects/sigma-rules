// Axios Supply Chain ECS Query 5 — C2 Network IOC: sfrclak.com / 142.11.206.73 (all platforms)

network
| where timestamp > ago(30d)
| where
    destination.ip == "142.11.206.73"
    or destination.domain contains "sfrclak"
| project
    timestamp,
    host.name,
    source.ip,
    destination.ip,
    destination.domain,
    destination.port,
    process.executable,
    process.command_line,
    user.name
| order by timestamp desc
